name = "seznam-oidc-cloudflare-access-shim"
main = "src/index.js"
compatibility_date = "2026-08-30"

[vars]
SEZNAM_CLIENT_ID = "ID_KLIENTA_ZE_SEZNAMU"
SEZNAM_REDIRECT_URL = "https://<vas-team>.cloudflareaccess.com/cdn-cgi/access/callback"

# Vytvořit přes `npx wrangler kv namespace create KV` a "id" z výstupu
# zapsat sem. Binding se musí jmenovat přesně "KV", jinak worker padá
# na 500 bez logu.
[[kv_namespaces]]
binding = "KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
